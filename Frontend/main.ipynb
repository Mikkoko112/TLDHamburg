    "#stores the data of the View for the whole route\n",
    "@app.callback(\n",
    "    Output('map-store', 'data'),\n",
    "    Input('route-layer', 'data'),\n",
    "    State(\"map\", \"zoom\"),\n",
    "    State(\"map\", \"center\")\n",
    ")\n",
    "def store_map_view(data, zoom, center):\n",
    "    if data is not None:\n",
    "        return {'center': center, 'zoom': zoom}\n",
    "    return no_update\n"
   ]
