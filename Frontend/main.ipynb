    "@app.callback(\n",
    "    Output(component_id=\"startpunkt\", component_property=\"valid\"), \n",
    "    Output(\"startpunkt\", \"invalid\"),\n",
    "    Output(component_id=\"endpunkt\", component_property=\"valid\"), \n",
    "    Output(\"endpunkt\", \"invalid\"),\n",
    "    Output(\"route\", \"n_clicks\"),\n",
    "    Output(\"coordinates_start\", \"children\"),\n",
    "    Output(\"coordinates_end\", \"children\"),\n",
    "    [Input(\"startpunkt\",\"value\"),\n",
    "     Input(\"endpunkt\",\"value\"),\n",
    "     Input(\"route\", \"n_clicks\")]\n",
    ")\n",
    "def check_validity(starttext, endtext, n_clicks):\n",
    "    if n_clicks:\n",
    "        if starttext or endtext: \n",
    "            is_alright = True\n",
    "            is_alright2 = True\n",
    "            #is_alright = starttext.endswith(\"test\")\n",
    "            #is_alright2 = endtext.endswith(\"test\")\n",
    "            start1, start2 = return_coordinates(starttext)\n",
    "            end1, end2 = return_coordinates(endtext)\n",
    "            #if start == (None, None):\n",
    "            if start1 == None:\n",
    "                is_alright = False\n",
    "            if end1 == None:\n",
    "                is_alright2 = False\n",
    "            return is_alright, not is_alright, is_alright2, not is_alright2, 0, f\"{start1}\\t{start2}\", f\"{end1}\\t{end2}\"\n",
    "    return False, False, False, False, 0, \"\", \"\" #no input yet\n",
    "\n",
    "\n",
    "# Callback to update the traffic light markers on the map\n",
    "@app.callback(\n",
    "    Output('marker-layer', 'children'),\n",
    "    [Input('interval-component', 'n_intervals')]\n",
    ")\n",
    "def update_traffic_lights(n):\n",
    "    # Simulate traffic light status changes\n",
    "    for light in traffic_lights:\n",
    "        light['status'] = random.choice([\"red\", \"green\", \"yellow\"])  # Random status change\n",
    "    return get_markers(traffic_lights)\n",
    "\n"
   ]
